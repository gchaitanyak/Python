{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "required": ["id", "moduleId", "title", "estimatedMinutes", "basePoints", "intro", "questions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^py-[a-z0-9-]+$" },
    "moduleId": { "type": "string" },
    "title": { "type": "string", "minLength": 3 },
    "estimatedMinutes": { "type": "integer", "minimum": 3, "maximum": 30 },
    "basePoints": { "type": "integer", "minimum": 1, "maximum": 50 },
    "intro": { "type": "string", "description": "Markdown shown before question 1" },
    "questions": {
      "type": "array", "minItems": 6, "maxItems": 14,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "required": ["name", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string", "description": "Python run after the learner's code in the same namespace; passes if it raises nothing. __output__ holds captured stdout." },
        "message": { "type": "string", "description": "Public message shown to the learner when this test fails" }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]{2}$" },
        "type": { "enum": ["explain", "write_code", "fix_code", "predict_output", "multiple_choice", "fill_blank"] },
        "prompt": { "type": "string" },
        "points": { "type": "integer", "minimum": 0 },
        "hint": { "type": "string" },
        "explanation": { "type": "string", "description": "Shown after a correct answer or with the solution" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "explain" } } },
          "then": { "properties": { "exampleCode": { "type": "string" } } } },
        { "if": { "properties": { "type": { "enum": ["write_code", "fix_code"] } } },
          "then": { "required": ["starterCode", "solution", "tests", "hint"],
                    "properties": { "starterCode": { "type": "string" }, "solution": { "type": "string" },
                                    "setupCode": { "type": "string" },
                                    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } } } } },
        { "if": { "properties": { "type": { "const": "predict_output" } } },
          "then": { "required": ["code", "expectedOutput", "hint"],
                    "properties": { "code": { "type": "string" }, "expectedOutput": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "multiple_choice" } } },
          "then": { "required": ["options", "answer", "hint"],
                    "properties": { "options": { "type": "array", "minItems": 2, "maxItems": 5,
                                                 "items": { "type": "object", "required": ["id", "text"],
                                                            "properties": { "id": { "type": "string" }, "text": { "type": "string" } } } },
                                    "answer": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "fill_blank" } } },
          "then": { "required": ["template", "blanks", "hint"],
                    "properties": { "template": { "type": "string", "description": "Code with ___ for each blank" },
                                    "blanks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                                    "matchMode": { "enum": ["tests", "exact"] },
                                    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } } } } }
      ]
    }
  }
}
