{
  "name": "python-exercises",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm --prefix functions install --no-audit --no-fund",
    "dev": "concurrently -k -n web,fb -c cyan,yellow \"npm:dev:web\" \"npm:dev:emulators\"",
    "dev:web": "vite",
    "dev:emulators": "node scripts/emulator-env.mjs && npm --prefix functions run build && firebase emulators:exec --ui --project demo-python-exercises \"tsx scripts/dev-services.ts\"",
    "build": "tsx scripts/build.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-python-exercises \"vitest run --config vitest.rules.config.ts\"",
    "validate:content": "tsx scripts/validate-content.ts",
    "deploy": "tsx scripts/deploy.ts --env=production",
    "test:functions": "node scripts/emulator-env.mjs && npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-python-exercises \"vitest run --config vitest.functions.config.ts\"",
    "fetch:pyodide": "tsx scripts/pyodide-packages.ts",
    "build:staging": "tsx scripts/build.ts --mode=staging",
    "deploy:staging": "tsx scripts/deploy.ts --env=staging",
    "deploy:production": "tsx scripts/deploy.ts --env=production"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.6",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "stripe": "^23.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "firebase": "^12.19.0",
    "pyodide": "314.0.7"
  }
}
