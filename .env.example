# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Public Firebase web config (Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-python-exercises
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# true = talk to the local Emulator Suite started by `npm run dev`.
# In dev with no VITE_FIREBASE_API_KEY at all, the emulators are used automatically.
VITE_USE_EMULATORS=true

# Used by scripts/generate-sitemap.ts
SITE_URL=https://example.com

# Server-side secrets are NOT set here. They go in Cloud Functions secrets
# (firebase functions:secrets:set ...) in later phases:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, LLM_API_KEY

# Prices shown on /pricing/ (display only; Stripe price ids are set for the functions, see docs/STRIPE.md)
VITE_PRICE_MONTHLY_LABEL=$12
VITE_PRICE_ANNUAL_LABEL=$79
VITE_PRICE_LIFETIME_LABEL=$199
